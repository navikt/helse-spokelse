<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="TJENESTEKALL_LEVEL" value="DEBUG"/>
    <include resource="no/nav/sykepenger/libs/logging/logback-base.xml"/>

    <appender name="auditLogger" class="com.papertrailapp.logback.Syslog4jAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <pattern>%d{MMM dd yyyy HH:mm:ss.SSS zzz} %level CEF:0|Vedtaksløsning for sykepenger|Spøkelse|1.0|audit:access|personoppslag|%level|%msg%n</pattern>
        </layout>

        <syslogConfig class="org.productivity.java.syslog4j.impl.net.tcp.TCPNetSyslogConfig">
            <host>audit.nais</host>
            <port>6514</port>
            <ident>spokelse</ident>
            <maxMessageLength>128000</maxMessageLength>
        </syslogConfig>
    </appender>

    <logger level="INFO" name="auditLogger" additivity="false">
        <appender-ref ref="auditLogger"/>
    </logger>

    <logger name="io.ktor.auth.jwt" level="TRACE" additivity="false">
        <appender-ref ref="team-logs"/>
    </logger>

    <logger name="no.nav" level="DEBUG"/>
</configuration>
